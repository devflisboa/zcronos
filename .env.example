FLASK_ENV=production
SECRET_KEY=troque-por-uma-chave-segura-aqui

# Banco de dados
DB_HOST=db:3306
DB_NAME=car_management
DB_USER=root
DB_PASSWORD=troque-por-senha-forte

# URL pública confiável usada nos links de confirmação (HTTPS em produção)
PUBLIC_BASE_URL=https://seu-dominio.example
MAIL_SERVER=smtp.seu-provedor.example
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=AUTOVIU <contato@seu-dominio.example>

# Integrações da Fase 3 — manter vazias até configurar os respectivos serviços
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback Google: https://seu-dominio.example/auth/google/callback
OPENAI_API_KEY=
OPENAI_VISION_MODEL=
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@seu-dominio.example
ALERTAS_AUTOMATICOS=false
ASAAS_ENV=sandbox
ASAAS_API_KEY=
# Token de webhook independente da API key: pelo menos 32 caracteres aleatórios
ASAAS_WEBHOOK_TOKEN=
# Frota aguarda decisão comercial: não preencher até resolver a divergência do roadmap
FROTA_PRECO=
# 0 significa ilimitado; um inteiro positivo define o limite
FROTA_LIMITE=
RATELIMIT_STORAGE_URI=memory://

# FIPE: token opcional, usado exclusivamente pelo backend
FIPE_API_TOKEN=
FIPE_CACHE_SECONDS=3600
